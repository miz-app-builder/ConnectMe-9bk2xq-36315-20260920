# NexTalk production call configuration
# Set these in the build environment; do not commit real TURN credentials.
EXPO_PUBLIC_TURN_URL=turn:your-turn-host:3478
EXPO_PUBLIC_TURN_USERNAME=your-turn-username
EXPO_PUBLIC_TURN_CREDENTIAL=your-turn-credential

# Expo EAS project ID is required for production Expo push tokens.
# EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
